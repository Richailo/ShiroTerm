# Generate a private .env and administrator password with setup.cjs.
SHIROTERM_DOMAIN=sync.example.com
PUBLIC_URL=https://sync.example.com
ADMIN_USER=admin
SHIROTERM_IMAGE=ghcr.io/richailo/shiroterm-server:0.1.0
DEVICE_SESSION_DAYS=30
HISTORY_LIMIT=100
# Optional fixed Vaultwarden HTTPS origin, configured by the server administrator.
VAULTWARDEN_URL=
VAULT_UNLOCK_MINUTES=60
